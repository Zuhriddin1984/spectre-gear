# Supabase → Project Settings → API (the public URL and the anon key are all the site needs)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Telegram reminders about overdue returns (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any long random string; Vercel sends it to the daily reminder job.
# Store the same value in the database: insert into app_secrets values ('cron_secret', '...');
CRON_SECRET=
